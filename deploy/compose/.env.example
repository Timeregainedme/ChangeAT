## MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=jellyfish
MYSQL_USER=jellyfish
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306

## Redis / Celery Broker
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# 如需单独覆盖完整 broker 地址，可设置：
# CELERY_BROKER_URL=redis://redis:6379/0

## Backend
# 可选：如需真实调用大模型，再设置
# OPENAI_API_KEY=

## RustFS (S3 compatible)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
S3_BUCKET_NAME=jellyfish-assets
# 自建 S3 兼容服务（RustFS/MinIO）必须用 path 寻址：
# 容器 DNS 无法解析 `<bucket>.<service>` 虚拟主机名。
S3_ADDRESSING_STYLE=path
# 浏览器可达的素材直链基址；不设置时前端无法展示已上传图片。
S3_PUBLIC_BASE_URL=http://localhost:9000/jellyfish-assets
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001

## Front runtime config (served as /env.js)
# 由于前后端分端口部署，浏览器应访问宿主机的后端地址
BACKEND_URL=http://localhost:8000
