!.env.example
# 本地 SQLite 与临时脚本不入库（生产用 MySQL，本地跑脚本时会自动生成空库文件）
*.db
*.sqlite
*.sqlite3
.tmp-*
.DS_Store
*.log
.pnpm-store/
.vscode/
.idea/

# AI 工具本地产物（会话日志 / 本地配置），不入库
.claude/logs/
.cursor/logs/
.opencode/

# 前端测试产物（Playwright 报告与失败快照），不入库
front/test-results/
front/playwright-report/
front/blob-report/

# Python / Backend
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.jellyfish.db
jellyfish.db
.env

